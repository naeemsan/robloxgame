      <Item class="ModuleScript" referent="130">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Owner settings. All paid features remain off until a real pass ID is supplied.
return {
    Title = "RUMAL RUSH",
    Version = "1.0.0",
    DataStore = "RumalRush_Profile_v1",
    NeonPassId = 0,
    WalkSpeed = 19,
    DashSpeed = 30,
    DashSeconds = 0.32,
    DashCooldown = 4.5,
    GrabRadius = 5.5,
    TagRadius = 4,
    PickupGrace = 0.8,
    RoundSeconds = 32,
    CountdownSeconds = 3,
    IntermissionSeconds = 8,
    ResultSeconds = 4,
    MatchTarget = 3,
    MaxRounds = 9,
    MaxPlayers = 8,
    HomeX = 34,
    BoundsX = 44,
    BoundsZ = 29,
    RoundWinCoins = 12,
    RoundPlayCoins = 4,
    MatchWinCoins = 25,
    Colors = {
        Coral = Color3.fromRGB(247, 109, 94),
        Teal = Color3.fromRGB(62, 201, 185),
        Ink = Color3.fromRGB(23, 35, 49),
        Cream = Color3.fromRGB(255, 243, 214),
        Gold = Color3.fromRGB(255, 207, 87),
    },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="131">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[return {
    { id = "Classic", name = "Classic gold", cost = 0, description = "The original courtyard scarf.", color = Color3.fromRGB(255, 207, 87) },
    { id = "Mint", name = "Mint sprint", cost = 80, description = "Fresh mint scarf + short trail.", color = Color3.fromRGB(119, 238, 188) },
    { id = "Berry", name = "Berry bold", cost = 160, description = "A bright berry scarf + trail.", color = Color3.fromRGB(190, 140, 242) },
    { id = "Sunset", name = "Sunset club", cost = 280, description = "Warm sunset scarf + trail.", color = Color3.fromRGB(255, 153, 91) },
    { id = "Neon", name = "Neon club", pass = true, description = "Permanent cosmetic. Same speed, same rules.", color = Color3.fromRGB(110, 209, 255) },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="132">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- Pure rules: no Roblox services. Executed by the offline regression suite.
local Rules = {}

function Rules.finite(n)
    return type(n) == "number" and n == n and math.abs(n) < math.huge
end

function Rules.validPosition(p, boundsX, boundsZ)
    return type(p) == "table" and Rules.finite(p.x) and Rules.finite(p.y)
        and Rules.finite(p.z) and math.abs(p.x) <= boundsX
        and math.abs(p.z) <= boundsZ and p.y >= 0 and p.y <= 14
end

function Rules.distance(a, b)
    local x, y, z = a.x - b.x, a.y - b.y, a.z - b.z
    return math.sqrt(x*x + y*y + z*z)
end

function Rules.canGrab(phase, hasCarrier, position, scarf, radius)
    return phase == "Live" and not hasCarrier and Rules.distance(position, scarf) <= radius
end

function Rules.canDash(phase, now, readyAt)
    return phase == "Live" and Rules.finite(now) and now >= readyAt
end

function Rules.resolve(args)
    if args.phase ~= "Live" then return nil end
    local c = args.carrier
    if c then
        local grace = args.now - args.pickedAt >= args.grace
        -- A tag on the line wins the tie; a player must cross safely.
        if grace and Rules.distance(args.positions[c], args.positions[3-c]) <= args.tagRadius then
            return { winner = 3-c, reason = "TAGGED!" }
        end
        local x = args.positions[c].x
        if (c == 1 and x <= -args.homeX) or (c == 2 and x >= args.homeX) then
            return { winner = c, reason = "HOME SAFE!" }
        end
    end
    if args.remaining <= 0 then
        return { winner = c and (3-c) or 0, reason = c and "TIME UP — DEFENSE WINS" or "NO PICKUP — DRAW" }
    end
    return nil
end

function Rules.matchWinner(a, b, rounds, target, limit)
    if a >= target then return 1 end
    if b >= target then return 2 end
    if rounds >= limit then
        if a == b then return 0 end
        return a > b and 1 or 2
    end
    return nil
end

function Rules.buy(profile, item)
    if not item or item.pass or not Rules.finite(item.cost) or item.cost < 0 then return false, "Unavailable" end
    if profile.owned[item.id] then
        profile.equipped = item.id
        return true, "Equipped"
    end
    if profile.coins < item.cost then return false, "Not enough coins" end
    profile.coins -= item.cost
    profile.owned[item.id] = true
    profile.equipped = item.id
    return true, "Unlocked and equipped"
end

function Rules.movementBudget(budget, distance, elapsed, maxSpeed)
    local replenished = math.min(9, budget + maxSpeed * math.max(0, elapsed))
    if not Rules.finite(distance) or distance > replenished then return false, replenished end
    return true, replenished - distance
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="133">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="134">
      <Properties>
        <string name="Name">RumalServer</string>
      </Properties>
      <Item class="ModuleScript" referent="135">
        <Properties>
          <string name="Name">Bot</string>
          <string name="Source"><![CDATA[local Bot = {}
Bot.__index = Bot
local function part(model, name, size, offset, color, ball)
    local p = Instance.new("Part")
    p.Name = name; p.Size = size; p.CFrame = CFrame.new(offset)
    p.Color = color; p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CastShadow = false
    if ball then p.Shape = Enum.PartType.Ball end
    p.Parent = model
    return p
end
function Bot.new(parent, color)
    local self = setmetatable({}, Bot)
    local model = Instance.new("Model")
    model.Name = "Milo • practice rival"
    local root = part(model,"Root",Vector3.new(2,2,1),Vector3.zero,color)
    root.Transparency = 1
    model.PrimaryPart = root
    part(model,"Jersey",Vector3.new(2.5,2.4,1.5),Vector3.new(0,0,0),color)
    part(model,"Head",Vector3.new(1.8,1.8,1.8),Vector3.new(0,2,0),Color3.fromRGB(225,174,129),true)
    part(model,"Hair",Vector3.new(1.9,.65,1.7),Vector3.new(0,2.8,.1),Color3.fromRGB(47,43,52))
    for _,x in ipairs({-0.4,0.4}) do
        part(model,"Eye",Vector3.new(.18,.22,.12),Vector3.new(x,2.1,-.85),Color3.fromRGB(23,35,49))
    end
    for _,x in ipairs({-1.6,1.6}) do
        part(model,"Arm",Vector3.new(.65,2,.8),Vector3.new(x,-.1,0),Color3.fromRGB(225,174,129))
    end
    for _,x in ipairs({-.65,.65}) do
        part(model,"Leg",Vector3.new(.85,1.5,1),Vector3.new(x,-1.9,0),Color3.fromRGB(40,58,76))
        part(model,"Shoe",Vector3.new(.95,.4,1.4),Vector3.new(x,-2.7,-.2),Color3.fromRGB(255,243,214))
    end
    local label = Instance.new("BillboardGui")
    label.Size = UDim2.fromOffset(160,28);label.StudsOffset = Vector3.new(0,4,0)
    label.AlwaysOnTop = true;label.Parent = root
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1,1);text.BackgroundTransparency = 1
    text.Text = "MILO · PRACTICE BOT";text.TextColor3 = Color3.fromRGB(23,35,49)
    text.TextSize = 12;text.Font = Enum.Font.GothamBold;text.Parent = label
    model.Parent = parent
    self.model = model;self.root = root;self.position = Vector3.new(34,3.1,0)
    self.dashReady = 0;self.dashUntil = 0;self.thinkAt = 0
    self:move(self.position, Vector3.new(-1,0,0))
    return self
end
function Bot:move(position, direction)
    self.position = position
    if direction.Magnitude < .01 then direction = Vector3.new(-1,0,0) end
    self.model:PivotTo(CFrame.lookAt(position,position+direction))
end
function Bot:step(dt, now, context)
    local target
    local easy = context.easy
    if context.carrier == context.side then
        target = Vector3.new(context.side == 1 and -37 or 37,3.1,0)
    elseif context.carrier then
        if now - context.pickedAt < (easy and .9 or .45) then return false end
        target = Vector3.new(context.opponent.X,3.1,context.opponent.Z)
    else
        target = Vector3.new(context.scarf.X,3.1,context.scarf.Z)
        -- A brief approach pause makes the pickup readable and allows a bluff.
        if now - context.started < (easy and 1.3 or .6) then return false end
    end
    local delta = target - self.position
    local speed = easy and 16 or 18.5
    if context.carrier and now >= self.dashReady and delta.Magnitude > 10 then
        self.dashUntil = now + .28
        self.dashReady = now + (easy and 7 or 5)
    end
    if now < self.dashUntil then speed = easy and 24 or 28 end
    if delta.Magnitude > .1 then
        local nextPosition = self.position + delta.Unit * math.min(delta.Magnitude, speed*dt)
        nextPosition = Vector3.new(math.clamp(nextPosition.X,-42,42),3.1,math.clamp(nextPosition.Z,-27,27))
        self:move(nextPosition,delta.Unit)
    end
    return not context.carrier and (self.position-context.scarf).Magnitude <= 3.5
end
function Bot:destroy() self.model:Destroy() end
return Bot
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="136">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Marketplace = game:GetService("MarketplaceService")
local PhysicsService = game:GetService("PhysicsService")
local Shared = RS:WaitForChild("RumalShared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Cosmetics = require(Shared.Cosmetics)
local Profiles = require(script.Parent.Profiles)
local Bot = require(script.Parent.Bot)
local arena = workspace:WaitForChild("Arena")
local lobbySpawn = arena:WaitForChild("LobbySpawn")
local runtime = Instance.new("Folder");runtime.Name = "RumalRuntime";runtime.Parent = workspace
local net = Instance.new("Folder");net.Name = "RumalNet";net.Parent = RS
local action = Instance.new("RemoteEvent");action.Name = "Action";action.Parent = net
local notice = Instance.new("RemoteEvent");notice.Name = "Notice";notice.Parent = net
local state = Instance.new("Folder");state.Name = "State";state.Parent = net
local actors = {}
local phase = "Lobby"
local carrier, pickedAt, liveStart, roundEnd = nil, 0, 0, 0
local scorer, resultReason = nil, ""
local cooldowns, monitors = {}, {}
local scarfPosition = Vector3.new(0,3.1,0)
local currentBot
local closing = false
local matchId = 0

pcall(function() PhysicsService:RegisterCollisionGroup("RumalPlayers") end)
PhysicsService:CollisionGroupSetCollidable("RumalPlayers","RumalPlayers",false)

local scarf = Instance.new("Part")
scarf.Name = "The Rumal";scarf.Size = Vector3.new(2.8,.18,2.8)
scarf.Color = Config.Colors.Gold;scarf.Material = Enum.Material.SmoothPlastic
scarf.Anchored = true;scarf.CanCollide = false;scarf.CanTouch = false;scarf.CastShadow = false
scarf.CFrame = CFrame.new(scarfPosition)*CFrame.Angles(0,math.pi/4,0)
scarf.Parent = runtime
local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Grab rumal";prompt.ObjectText = "Then run HOME!"
prompt.KeyboardKeyCode = Enum.KeyCode.E;prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
prompt.HoldDuration = 0;prompt.MaxActivationDistance = Config.GrabRadius
prompt.RequiresLineOfSight = false;prompt.Enabled = false;prompt.Parent = scarf
local beacon = Instance.new("BillboardGui")
beacon.Size = UDim2.fromOffset(150,32);beacon.StudsOffset = Vector3.new(0,3,0)
beacon.AlwaysOnTop = true;beacon.Parent = scarf
local beaconText = Instance.new("TextLabel")
beaconText.BackgroundColor3 = Config.Colors.Ink;beaconText.BackgroundTransparency = .15
beaconText.Size = UDim2.fromScale(1,1);beaconText.TextColor3 = Config.Colors.Cream
beaconText.Text = "THE RUMAL";beaconText.Font = Enum.Font.GothamBold;beaconText.TextSize = 14
beaconText.Parent = beacon
Instance.new("UICorner",beaconText).CornerRadius = UDim.new(0,8)

local function now() return workspace:GetServerTimeNow() end
local function attributes(values) for key,value in pairs(values) do state:SetAttribute(key,value) end end
local function setPhase(value, seconds, headline)
    phase = value
    attributes({Phase=value,EndsAt=now()+(seconds or 0),Headline=headline or ""})
    prompt.Enabled = value == "Live" and not carrier
end
local function notify(player,text) if player and player.Parent then notice:FireClient(player,text) end end
local function rootFor(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local human = character and character:FindFirstChildOfClass("Humanoid")
    if root and human and human.Health > 0 then return root,human end
    return nil,nil
end
local function position(side)
    local actor = actors[side]
    if not actor then return nil end
    if actor.bot then return actor.bot.position end
    local root = actor.player and rootFor(actor.player)
    return root and root.Position or nil
end
local function point(v) return {x=v.X,y=v.Y,z=v.Z} end
local function actorSide(player)
    for side,actor in pairs(actors) do if actor.player == player then return side end end
    return nil
end
local function lobby(player)
    player:SetAttribute("Active",false)
    player:SetAttribute("Carrying",false)
    local root,human = rootFor(player)
    if root then
        root.Anchored = false;root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new((player.UserId%5-2)*4,10,44)
        -- Spectators stay on the viewing deck; active runners are moved by spawnActor.
        human.WalkSpeed = 0
        human.JumpPower = 0;human.JumpHeight = 0
    end
    monitors[player] = nil
end
local function visual(player)
    local root = rootFor(player)
    if not root then return end
    for _,name in ipairs({"CosmeticTrail","CosmeticA","CosmeticB"}) do
        local old = root:FindFirstChild(name);if old then old:Destroy() end
    end
    local id = player:GetAttribute("Equipped") or "Classic"
    if id == "Classic" then return end
    local color
    for _,item in ipairs(Cosmetics) do if item.id == id then color = item.color end end
    if not color then return end
    local a = Instance.new("Attachment");a.Name = "CosmeticA";a.Position = Vector3.new(-.6,0,0);a.Parent = root
    local b = Instance.new("Attachment");b.Name = "CosmeticB";b.Position = Vector3.new(.6,0,0);b.Parent = root
    local trail = Instance.new("Trail");trail.Name = "CosmeticTrail";trail.Attachment0 = a;trail.Attachment1 = b
    trail.Lifetime = .25;trail.Color = ColorSequence.new(color);trail.FaceCamera = true
    trail.Transparency = NumberSequence.new(.3,1);trail.Parent = root
end
local function clearActors()
    for _,actor in pairs(actors) do
        if actor.player and actor.player.Parent then lobby(actor.player) end
    end
    actors = {};carrier = nil;prompt.Enabled = false
    if currentBot then currentBot:destroy();currentBot = nil end
    scarf.Transparency = 0;scarf.Color = Config.Colors.Gold
    scarf.CFrame = CFrame.new(scarfPosition)*CFrame.Angles(0,math.pi/4,0)
    beaconText.Text = "THE RUMAL"
    attributes({Carrier=0,TealUserId=0,CoralUserId=0})
end
local function finish(winner,reason)
    if phase ~= "Live" and phase ~= "Countdown" then return end
    scorer = winner;resultReason = reason
    setPhase("Result",Config.ResultSeconds,reason)
    for _,actor in pairs(actors) do
        if actor.player then
            local root = rootFor(actor.player)
            if root then root.Anchored = true end
        end
    end
end
local function validActor(player)
    local root = rootFor(player)
    if not root then return false end
    return Rules.validPosition(point(root.Position),Config.BoundsX,Config.BoundsZ)
end
local function grab(side)
    if not side or carrier or phase ~= "Live" then return end
    local pos = position(side)
    if not pos or not Rules.validPosition(point(pos),Config.BoundsX,Config.BoundsZ) then return end
    if not Rules.canGrab(phase,carrier ~= nil,point(pos),point(scarfPosition),Config.GrabRadius) then return end
    -- Check displacement on the request path as well as in the simulation tick.
    local actor = actors[side]
    if actor.player then
        local m = monitors[actor.player]
        if not m or (pos-m.last).Magnitude > 9 then return end
    end
    carrier = side;pickedAt = now();prompt.Enabled = false
    state:SetAttribute("Carrier",side)
    if actor.player then actor.player:SetAttribute("Carrying",true) end
    local id = actor.player and actor.player:GetAttribute("Equipped") or "Classic"
    for _,item in ipairs(Cosmetics) do if item.id == id then scarf.Color = item.color end end
    beaconText.Text = side == 1 and "← TEAL: GET HOME" or "CORAL: GET HOME →"
end
prompt.Triggered:Connect(function(player) grab(actorSide(player)) end)

local function refreshPass(player)
    if Config.NeonPassId <= 0 then return end
    local ok,owned = pcall(function() return Marketplace:UserOwnsGamePassAsync(player.UserId,Config.NeonPassId) end)
    if ok and player.Parent then
        player:SetAttribute("NeonOwned",owned)
        if owned then notify(player,"Neon club unlocked. Equip it in your locker.") end
    end
end
Marketplace.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
    if purchased and id == Config.NeonPassId then task.spawn(refreshPass,player) end
end)

local function setup(player)
    player:SetAttribute("Ready",false);player:SetAttribute("Active",false)
    player:SetAttribute("Side",0);player:SetAttribute("DashReadyAt",0)
    player:SetAttribute("Difficulty","Easy");player:SetAttribute("NeonOwned",false)
    player.RespawnLocation = lobbySpawn
    local function characterAdded(character)
        local root = character:WaitForChild("HumanoidRootPart",10)
        local human = character:WaitForChild("Humanoid",10)
        if not root or not human or not player.Parent then return end
        local function collision(object)
            if object:IsA("BasePart") then object.CollisionGroup = "RumalPlayers" end
        end
        for _,object in ipairs(character:GetDescendants()) do collision(object) end
        character.DescendantAdded:Connect(collision)
        human.JumpPower = 0;human.JumpHeight = 0;human.WalkSpeed = Config.WalkSpeed
        local side = actorSide(player)
        if side then finish(3-side,"OPPONENT RESET — ROUND WON") end
        lobby(player);visual(player)
        human.Died:Connect(function()
            local activeSide = actorSide(player)
            if activeSide then finish(3-activeSide,"OPPONENT OUT — ROUND WON") end
        end)
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded,player.Character) end
    task.spawn(function() Profiles.load(player);if player.Parent then visual(player);refreshPass(player) end end)
end
Players.PlayerAdded:Connect(setup)
for _,player in ipairs(Players:GetPlayers()) do setup(player) end
Players.PlayerRemoving:Connect(function(player)
    local side = actorSide(player)
    if side then finish(3-side,"OPPONENT LEFT — ROUND WON") end
    cooldowns[player] = nil;monitors[player] = nil
    Profiles.remove(player)
end)
Profiles.start()

-- The remote never accepts positions, rewards, prices, ownership, or winner claims.
action.OnServerEvent:Connect(function(player,kind,value)
    if type(kind) ~= "string" then return end
    local time = now()
    local rate = cooldowns[player] or {time=time,tokens=12}
    rate.tokens = math.min(12,rate.tokens+(time-rate.time)*6);rate.time = time
    cooldowns[player] = rate
    if rate.tokens < 1 then return end
    rate.tokens -= 1
    if kind == "Ready" and type(value) == "boolean" then
        if not Profiles.get(player) then notify(player,"Loading progress. Try again in a moment.");return end
        player:SetAttribute("Ready",value)
        if not value then
            local side = actorSide(player)
            if side then finish(3-side,"OPPONENT SAT OUT") else lobby(player) end
        end
    elseif kind == "Difficulty" and (value == "Easy" or value == "Standard") then
        if not player:GetAttribute("Active") then player:SetAttribute("Difficulty",value) end
    elseif kind == "Grab" then
        grab(actorSide(player))
    elseif kind == "Dash" then
        if not actorSide(player) or not validActor(player) then return end
        if not Rules.canDash(phase,time,player:GetAttribute("DashReadyAt") or 0) then return end
        local _,human = rootFor(player)
        if not human then return end
        player:SetAttribute("DashReadyAt",time+Config.DashCooldown)
        human.WalkSpeed = Config.DashSpeed
        local monitor = monitors[player]
        if monitor then monitor.dashUntil = time+Config.DashSeconds end
    elseif kind == "Equip" and type(value) == "string" and #value <= 20 then
        local ok,message = Profiles.buy(player,value)
        notify(player,message)
        if ok then visual(player) end
    end
end)

-- Server simulation: bot, movement checks, pickup follow, tags and home-line scoring.
local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
    accumulator += dt
    if accumulator < .05 then return end
    local elapsed = math.min(accumulator,.25);accumulator = 0
    if phase ~= "Live" then return end
    local time = now()
    for side,actor in pairs(actors) do
        if actor.player then
            local root,human = rootFor(actor.player)
            if not root then finish(3-side,"OPPONENT OUT — ROUND WON");return end
            local m = monitors[actor.player]
            if not m then finish(3-side,"ROUND RESET");return end
            if time >= m.dashUntil then human.WalkSpeed = Config.WalkSpeed end
            local pos = root.Position
            local horizontal = Vector3.new(pos.X-m.last.X,0,pos.Z-m.last.Z).Magnitude
            local allowedSpeed = time < m.dashUntil + .15 and Config.DashSpeed+4 or Config.WalkSpeed+4
            local ok,budget = Rules.movementBudget(m.budget,horizontal,time-m.checked,allowedSpeed)
            m.budget = budget;m.checked = time
            if not ok or not Rules.validPosition(point(pos),Config.BoundsX,Config.BoundsZ) then
                root.CFrame = CFrame.new(m.last);root.AssemblyLinearVelocity = Vector3.zero
                m.violations += 1
                if m.violations >= 4 then finish(3-side,"OUT OF BOUNDS — ROUND LOST");return end
            else
                m.last = pos
            end
        elseif actor.bot then
            local enemy = position(3-side)
            if not enemy then finish(side,"OPPONENT LEFT");return end
            local humanActor = actors[3-side]
            local easy = not humanActor.player or humanActor.player:GetAttribute("Difficulty") ~= "Standard"
            local wantsGrab = actor.bot:step(elapsed,time,{
                side=side,carrier=carrier,opponent=enemy,scarf=scarfPosition,
                started=liveStart,pickedAt=pickedAt,easy=easy,
            })
            if wantsGrab then grab(side) end
        end
    end
    local a,b = position(1),position(2)
    if not a or not b then return end
    if carrier then
        local p = carrier == 1 and a or b
        scarf.CFrame = CFrame.new(p+Vector3.new(0,3.8,0))*CFrame.Angles(0,math.pi/4,0)
    end
    local outcome = Rules.resolve({phase=phase,carrier=carrier,pickedAt=pickedAt,now=time,
        grace=Config.PickupGrace,positions={point(a),point(b)},homeX=Config.HomeX,
        tagRadius=Config.TagRadius,remaining=roundEnd-time})
    if outcome then finish(outcome.winner,outcome.reason) end
end)

local function readyPlayers()
    local list = {}
    for _,player in ipairs(Players:GetPlayers()) do
        if player:GetAttribute("Ready") and Profiles.get(player) and rootFor(player) then table.insert(list,player) end
    end
    table.sort(list,function(a,b) return a.UserId < b.UserId end)
    return list
end
local function waitPhase(seconds)
    local deadline = now()+seconds
    while now() < deadline and not closing do task.wait(.1) end
end
local function choose(roster,cursor)
    if #roster == 0 then return nil,cursor end
    for offset=1,#roster do
        local index = (cursor+offset-1)%#roster+1
        local player = roster[index]
        if player.Parent and player:GetAttribute("Ready") and rootFor(player) then return player,index end
    end
    return nil,cursor
end
local function spawnActor(player,side)
    local x = side == 1 and -36 or 36
    if player then
        local root,human = rootFor(player)
        if not root then return nil end
        player:SetAttribute("Side",side);player:SetAttribute("Active",true)
        player:SetAttribute("Carrying",false);player:SetAttribute("DashReadyAt",0)
        root.CFrame = CFrame.lookAt(Vector3.new(x,3.2,0),Vector3.new(0,3.2,0))
        root.AssemblyLinearVelocity = Vector3.zero;root.Anchored = true
        human.WalkSpeed = Config.WalkSpeed
        monitors[player] = {last=root.Position,checked=now(),budget=9,dashUntil=0,violations=0}
        return {player=player,name=player.DisplayName}
    end
    currentBot = Bot.new(runtime,side == 1 and Config.Colors.Teal or Config.Colors.Coral)
    currentBot:move(Vector3.new(x,3.1,0),Vector3.new(-x,0,0))
    return {bot=currentBot,name="Milo (bot)"}
end
attributes({Phase="Lobby",Headline="Your next courtyard rivalry starts here.",EndsAt=0,
    TealScore=0,CoralScore=0,Round=0,Carrier=0,Mode="Practice",TealUserId=0,CoralUserId=0,
    TealName="TEAL",CoralName="CORAL",Match=0,Winner=0,Variant="Classic center"})
game:BindToClose(function() closing = true end)

task.spawn(function()
    while not closing do
        clearActors()
        setPhase("Lobby",0,"Press PLAY to enter the courtyard")
        repeat task.wait(.5) until #readyPlayers() > 0 or closing
        if closing then break end
        matchId += 1
        local scores,cursors = {0,0},{0,0}
        attributes({TealScore=0,CoralScore=0,Round=0,Winner=0,Match=matchId})
        setPhase("Intermission",Config.IntermissionSeconds,"FIRST TO 3 • one runner per team each round")
        waitPhase(Config.IntermissionSeconds)
        -- Accept friends who join during the countdown, then lock rosters for this match.
        local list = readyPlayers()
        local rosters = {{},{}}
        for index,player in ipairs(list) do
            if index <= Config.MaxPlayers then
                local side = (index-1)%2+1
                table.insert(rosters[side],player);player:SetAttribute("Side",side)
            end
        end
        state:SetAttribute("Mode",#list == 1 and "Practice" or "Team duel")
        local completed = 0
        local matchWinner
        for round=1,Config.MaxRounds do
            if #readyPlayers() == 0 or closing then break end
            clearActors()
            local a,b
            a,cursors[1] = choose(rosters[1],cursors[1])
            b,cursors[2] = choose(rosters[2],cursors[2])
            if not a and not b then break end
            -- Missing team gets a practice opponent; a bot never occupies both sides.
            actors[1] = spawnActor(a,1);actors[2] = spawnActor(b,2)
            if not actors[1] or not actors[2] then break end
            local offset = ({0,-9,9})[(round-1)%3+1]
            scarfPosition = Vector3.new(0,3.1,offset)
            scarf.CFrame = CFrame.new(scarfPosition)*CFrame.Angles(0,math.pi/4,0)
            carrier = nil;scorer = nil
            attributes({Round=round,Carrier=0,Winner=0,TealName=actors[1].name,CoralName=actors[2].name,
                TealUserId=a and a.UserId or 0,CoralUserId=b and b.UserId or 0,
                Mode=(not a or not b) and "Practice" or "Team duel",
                Variant=offset == 0 and "Classic center" or "Side-step pickup"})
            setPhase("Countdown",Config.CountdownSeconds,"READY • grab the rumal, then reach YOUR home line")
            waitPhase(Config.CountdownSeconds)
            if scorer == nil then
                liveStart = now();roundEnd = liveStart+Config.RoundSeconds
                for _,actor in pairs(actors) do
                    if actor.player then
                        local root = rootFor(actor.player)
                        if root then root.Anchored = false;monitors[actor.player].checked = now() end
                    end
                end
                setPhase("Live",Config.RoundSeconds,"GRAB • DODGE • GET HOME")
                while phase == "Live" and not closing do task.wait(.1) end
            end
            completed = round
            if scorer and scorer > 0 then scores[scorer] += 1 end
            attributes({TealScore=scores[1],CoralScore=scores[2],Winner=scorer or 0})
            -- Only completed live duels pay; resets during countdown cannot farm coins.
            if liveStart > 0 and now()-liveStart >= 2 and resultReason ~= "OPPONENT SAT OUT" then
                for side,actor in pairs(actors) do
                    if actor.player and actor.player.Parent and actor.player:GetAttribute("Ready") then
                        Profiles.reward(actor.player,side == scorer and Config.RoundWinCoins or Config.RoundPlayCoins,false)
                    end
                end
            end
            liveStart = 0
            waitPhase(Config.ResultSeconds)
            matchWinner = Rules.matchWinner(scores[1],scores[2],round,Config.MatchTarget,Config.MaxRounds)
            if matchWinner ~= nil then break end
        end
        clearActors()
        if completed > 0 and matchWinner ~= nil then
            local text = matchWinner == 0 and "MATCH DRAW" or (matchWinner == 1 and "TEAL TAKES THE MATCH!" or "CORAL TAKES THE MATCH!")
            if matchWinner > 0 then
                for _,player in ipairs(rosters[matchWinner]) do
                    if player.Parent and player:GetAttribute("Ready") then Profiles.reward(player,Config.MatchWinCoins,true) end
                end
            end
            attributes({Winner=matchWinner,Headline=text})
            setPhase("MatchEnd",7,text)
            waitPhase(7)
        end
        -- Participants choose a rematch. Late arrivals keep their place in the queue.
        for _,roster in ipairs(rosters) do
            for _,player in ipairs(roster) do
                if player.Parent then
                    player:SetAttribute("Ready",false);player:SetAttribute("Side",0)
                end
            end
        end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="137">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DSS = game:GetService("DataStoreService")
local Http = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.RumalShared.Config)
local Rules = require(RS.RumalShared.Rules)
local Items = require(RS.RumalShared.Cosmetics)
local Profiles = {}
local entries = {}
local store
local LEASE = 180
local allowed = {Classic = true, Mint = true, Berry = true, Sunset = true}

if game.GameId ~= 0 then
    local ok, value = pcall(function() return DSS:GetDataStore(Config.DataStore) end)
    if ok then store = value else warn("Rumal Rush: persistence unavailable", value) end
end

local function clean(raw)
    raw = type(raw) == "table" and raw or {}
    local function integer(n)
        return Rules.finite(n) and math.clamp(math.floor(n), 0, 100000000) or 0
    end
    local owned = {Classic = true}
    if type(raw.owned) == "table" then
        for id in pairs(allowed) do if raw.owned[id] == true then owned[id] = true end end
    end
    return {
        coins = integer(raw.coins), wins = integer(raw.wins), rounds = integer(raw.rounds),
        owned = owned, equipped = owned[raw.equipped] and raw.equipped or "Classic",
    }
end

function Profiles.get(player) return entries[player] end

function Profiles.sync(player)
    local data = entries[player]
    if not data then return end
    player:SetAttribute("Coins", data.coins)
    player:SetAttribute("Wins", data.wins)
    player:SetAttribute("Equipped", data.equipped)
    player:SetAttribute("SavingAvailable", data.loaded)
    for id in pairs(allowed) do player:SetAttribute("Own_" .. id, data.owned[id] == true) end
    local stats = player:FindFirstChild("leaderstats")
    if stats then stats.Coins.Value = data.coins; stats.Wins.Value = data.wins end
end

function Profiles.save(player, release)
    local data = entries[player]
    if not data or not data.loaded or not store then return end
    local deadline = os.clock() + 10
    while data.saving and os.clock() < deadline do task.wait(0.1) end
    if data.saving or not data.loaded then return end
    data.saving = true
    local snapshot = clean(data)
    local ok, result
    for attempt = 1, 3 do
        ok, result = pcall(function()
            return store:UpdateAsync("player_" .. player.UserId, function(previous)
                if type(previous) ~= "table" or type(previous.lock) ~= "table"
                    or previous.lock.token ~= data.token then return nil end
                if release then
                    snapshot.lock = nil
                else
                    snapshot.lock = {token = data.token, expires = os.time() + LEASE}
                end
                return snapshot
            end)
        end)
        if ok then break end
        task.wait(attempt)
    end
    data.saving = false
    if not ok then
        warn("Rumal Rush: progress save failed", player.UserId)
        player:SetAttribute("SaveWarning", true)
    elseif result == nil then
        data.loaded = false
        Profiles.sync(player)
    else
        player:SetAttribute("SaveWarning", false)
    end
    if release then data.loaded = false end
end

function Profiles.load(player)
    local token = Http:GenerateGUID(false)
    local ok, result = false, nil
    if store then
        for attempt = 1, 3 do
            ok, result = pcall(function()
                return store:UpdateAsync("player_" .. player.UserId, function(previous)
                    if type(previous) == "table" and type(previous.lock) == "table"
                        and type(previous.lock.expires) == "number"
                        and previous.lock.expires > os.time() and previous.lock.token ~= token then
                        return nil
                    end
                    local value = clean(previous)
                    value.lock = {token = token, expires = os.time() + LEASE}
                    return value
                end)
            end)
            if ok then break end
            task.wait(attempt)
        end
    end
    local data = clean(result)
    data.loaded = ok and type(result) == "table"
    data.token = token
    entries[player] = data
    if not player.Parent then
        Profiles.save(player, true)
        entries[player] = nil
        return
    end
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player
    for _, name in ipairs({"Coins", "Wins"}) do
        local value = Instance.new("IntValue")
        value.Name = name
        value.Parent = stats
    end
    Profiles.sync(player)
end

function Profiles.reward(player, coins, win)
    local data = entries[player]
    if not data then return end
    data.coins += coins
    if win then data.wins += 1 end
    Profiles.sync(player)
end

function Profiles.buy(player, id)
    local data = entries[player]
    if not data then return false, "Progress is still loading" end
    for _, item in ipairs(Items) do
        if item.id == id then
            if item.pass then
                if not player:GetAttribute("NeonOwned") then return false, "Pass not owned" end
                -- Pass ownership is independently rechecked every join.
                data.equipped = "Neon"
                Profiles.sync(player)
                return true, "Neon equipped"
            end
            local ok, message = Rules.buy(data, item)
            Profiles.sync(player)
            return ok, message
        end
    end
    return false, "Unknown cosmetic"
end

function Profiles.remove(player)
    Profiles.save(player, true)
    entries[player] = nil
end

function Profiles.start()
    task.spawn(function()
        while true do
            task.wait(45)
            for player in pairs(entries) do
                task.spawn(Profiles.save, player, false)
            end
        end
    end)
    game:BindToClose(function()
        local pending = 0
        for player in pairs(entries) do
            pending += 1
            task.spawn(function() Profiles.save(player, true); pending -= 1 end)
        end
        local deadline = os.clock() + 25
        repeat task.wait(0.1) until pending == 0 or os.clock() >= deadline
    end)
end
return Profiles
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="138">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">0</float>
      <float name="CharacterWalkSpeed">19</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="139">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="140">
        <Properties>
          <string name="Name">RumalClient</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInput = game:GetService("UserInputService")
local ContextAction = game:GetService("ContextActionService")
local Marketplace = game:GetService("MarketplaceService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local Shared = RS:WaitForChild("RumalShared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local net = RS:WaitForChild("RumalNet")
local action, state, notice = net:WaitForChild("Action"), net:WaitForChild("State"), net:WaitForChild("Notice")
local C = Config.Colors
local camera = workspace.CurrentCamera
local overview, reducedMotion, shopOpen, helpOpen = true, false, false, false
local passPrice
local purchaseBusy = false
local notification, notificationUntil, lastPhase = "", 0, ""
local lastCoins
local renderClock = 0

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
local gui = Instance.new("ScreenGui")
gui.Name = "RumalRushUI";gui.ResetOnSpawn = false;gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local root = Instance.new("Frame")
root.Name = "ResponsiveRoot";root.BackgroundTransparency = 1;root.Size = UDim2.fromScale(1,1);root.Parent = gui
local function round(parent,radius)
    local c = Instance.new("UICorner");c.CornerRadius = UDim.new(0,radius or 12);c.Parent = parent
end
local function frame(parent,name,pos,size,color)
    local f = Instance.new("Frame");f.Name = name;f.Position = pos;f.Size = size
    f.BackgroundColor3 = color or C.Ink;f.BorderSizePixel = 0;f.Parent = parent;round(f,14)
    return f
end
local function text(parent,name,value,pos,size,fontSize,color,align)
    local l = Instance.new("TextLabel");l.Name = name;l.Text = value;l.Position = pos;l.Size = size
    l.BackgroundTransparency = 1;l.TextColor3 = color or C.Cream;l.Font = Enum.Font.GothamBold
    l.TextSize = fontSize or 16;l.TextWrapped = true;l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.Parent = parent
    return l
end
local function button(parent,name,value,pos,size,color,callback)
    local b = Instance.new("TextButton");b.Name = name;b.Text = value;b.Position = pos;b.Size = size
    b.BackgroundColor3 = color or C.Teal;b.TextColor3 = C.Ink;b.Font = Enum.Font.GothamBold
    b.TextSize = 15;b.TextWrapped = true;b.AutoButtonColor = true;b.BorderSizePixel = 0;b.Parent = parent
    round(b,10);b.Activated:Connect(callback)
    return b
end
local function cap(parent,width,height)
    local c = Instance.new("UISizeConstraint")
    c.MaxSize = Vector2.new(width,height or 10000);c.Parent = parent
end
local function toast(value) notification = value;notificationUntil = os.clock()+3.5 end
local function send(kind,value) action:FireServer(kind,value) end

local header = frame(root,"Scoreboard",UDim2.new(.5,0,0,8),UDim2.new(.92,0,0,76))
header.AnchorPoint = Vector2.new(.5,0);cap(header,560,76)
local tealScore = text(header,"TealScore","TEAL  0",UDim2.new(0,12,0,10),UDim2.new(.3,-12,0,28),21,C.Teal)
local coralScore = text(header,"CoralScore","0  CORAL",UDim2.new(.7,0,0,10),UDim2.new(.3,-12,0,28),21,C.Coral)
local clock = text(header,"Clock","RUMAL RUSH",UDim2.new(.3,0,0,8),UDim2.new(.4,0,0,30),17,C.Gold)
local matchInfo = text(header,"MatchInfo","FIRST TO 3",UDim2.new(0,8,0,44),UDim2.new(1,-16,0,22),12)
local banner = text(root,"Instruction","",UDim2.new(.5,0,0,94),UDim2.new(.9,0,0,36),17,C.Ink)
banner.AnchorPoint = Vector2.new(.5,0);cap(banner,680,36)
banner.TextStrokeColor3 = C.Cream;banner.TextStrokeTransparency = .55

local tools = frame(root,"Tools",UDim2.new(0,12,1,-116),UDim2.fromOffset(142,102))
local wallet = text(tools,"Wallet","0 COINS",UDim2.fromOffset(6,4),UDim2.new(1,-12,0,26),15,C.Gold)
button(tools,"Locker","LOCKER",UDim2.fromOffset(8,35),UDim2.fromOffset(126,28),C.Cream,function()
    shopOpen = not shopOpen;helpOpen = false
end)
button(tools,"Help","HOW TO PLAY",UDim2.fromOffset(8,69),UDim2.fromOffset(126,25),C.Teal,function()
    helpOpen = not helpOpen;shopOpen = false
end)
local status = text(root,"Status","",UDim2.new(.5,0,1,-35),UDim2.new(.48,0,0,27),11,C.Cream)
status.AnchorPoint = Vector2.new(.5,0)
status.BackgroundColor3 = C.Ink;status.BackgroundTransparency = .15;round(status,8)
local exit = button(root,"SitOut","SIT OUT",UDim2.new(1,-116,0,94),UDim2.fromOffset(104,28),C.Cream,function()
    send("Ready",false)
end)
exit.Visible = false
local controls = frame(root,"Actions",UDim2.new(1,-160,1,-138),UDim2.fromOffset(148,124))
controls.BackgroundTransparency = 1
local grabButton = button(controls,"Grab","GRAB [E]",UDim2.fromOffset(0,0),UDim2.fromOffset(148,52),C.Gold,function() send("Grab") end)
local dashButton = button(controls,"Dash","DASH [SHIFT]",UDim2.fromOffset(0,62),UDim2.fromOffset(148,52),C.Teal,function() send("Dash") end)

local menu = frame(root,"Welcome",UDim2.fromScale(.5,.52),UDim2.new(.9,0,0,384))
menu.AnchorPoint = Vector2.new(.5,.5);cap(menu,590,384)
text(menu,"Kicker","THE COURTYARD IS CALLING",UDim2.new(0,20,0,19),UDim2.new(1,-40,0,22),12,C.Teal)
text(menu,"Title","RUMAL RUSH",UDim2.new(0,16,0,44),UDim2.new(1,-32,0,49),36,C.Cream)
text(menu,"Subtitle","A real playground rivalry. One scarf. Two sides.",UDim2.new(0,24,0,97),UDim2.new(1,-48,0,38),16,C.Gold)
local instructions = {
    {"01", "GRAB", "Reach the scarf. Press E or tap GRAB."},
    {"02", "OUTSMART", "Bait your rival. Save your dash for the chase."},
    {"03", "GET HOME", "Cross your colored line. Or tag the carrier!"},
}
for i,step in ipairs(instructions) do
    local y = 145+(i-1)*44
    text(menu,"Number"..i,step[1],UDim2.new(0,20,0,y),UDim2.fromOffset(28,32),18,C.Teal)
    text(menu,"Step"..i,step[2].."  /  "..step[3],UDim2.new(0,58,0,y),UDim2.new(1,-78,0,36),13,C.Cream,Enum.TextXAlignment.Left)
end
local play = button(menu,"Play","PLAY A MATCH",UDim2.new(.06,0,1,-90),UDim2.new(.58,0,0,46),C.Teal,function()
    shopOpen = false;helpOpen = false;send("Ready",true)
end)
local difficulty = button(menu,"Difficulty","BOT: EASY",UDim2.new(.67,0,1,-90),UDim2.new(.27,0,0,46),C.Gold,function()
    send("Difficulty",player:GetAttribute("Difficulty") == "Standard" and "Easy" or "Standard")
end)
text(menu,"SoloHint","Solo? Milo joins you. Friends? Take turns in team duels.",UDim2.new(.05,0,1,-37),UDim2.new(.9,0,0,27),12,C.Cream)

local help = frame(root,"HelpPanel",UDim2.fromScale(.5,.52),UDim2.new(.9,0,0,360))
help.AnchorPoint = Vector2.new(.5,.5);cap(help,580,360);help.Visible = false
text(help,"Title","WIN THE CHASE",UDim2.new(0,16,0,20),UDim2.new(1,-32,0,35),27,C.Gold)
text(help,"Rules",[[1. Nobody can tag until someone takes the rumal.
2. Carry it over YOUR home line to score.
3. Chase the carrier; close contact tags automatically.
4. Dash gives a short speed burst, NOT invincibility.
5. No pickup before time runs out? The round is a draw.
6. First team to 3 wins. Teammates rotate each round.]],UDim2.new(0,24,0,68),UDim2.new(1,-48,0,180),15,C.Cream,Enum.TextXAlignment.Left)
text(help,"Inputs","MOVE: WASD / left stick / touch stick\nGRAB: E / X   •   DASH: Shift / B",UDim2.new(0,24,0,250),UDim2.new(1,-48,0,44),13,C.Teal)
button(help,"Close","GOT IT",UDim2.new(.3,0,1,-54),UDim2.new(.4,0,0,38),C.Teal,function() helpOpen = false end)

local shop = frame(root,"LockerPanel",UDim2.fromScale(.5,.52),UDim2.new(.92,0,0,446))
shop.AnchorPoint = Vector2.new(.5,.5);cap(shop,610,446);shop.Visible = false
text(shop,"Title","YOUR LOCKER",UDim2.new(0,20,0,16),UDim2.new(1,-80,0,32),25,C.Gold,Enum.TextXAlignment.Left)
button(shop,"Close","X",UDim2.new(1,-50,0,15),UDim2.fromOffset(34,32),C.Cream,function() shopOpen = false end)
text(shop,"Note","Cosmetics only. Everyone has the same speed and dash.",UDim2.new(0,20,0,52),UDim2.new(1,-40,0,30),12)
local shopButtons = {}
for i,item in ipairs(Cosmetics) do
    local row = frame(shop,"Item_"..item.id,UDim2.new(0,16,0,90+(i-1)*56),UDim2.new(1,-32,0,49),Color3.fromRGB(38,52,65))
    frame(row,"Swatch",UDim2.fromOffset(10,10),UDim2.fromOffset(28,28),item.color)
    text(row,"Name",item.name,UDim2.fromOffset(48,3),UDim2.new(.6,-48,0,23),14,C.Cream,Enum.TextXAlignment.Left)
    text(row,"Description",item.pass and "Permanent cosmetic pass" or "Earned with play coins",UDim2.fromOffset(48,26),UDim2.new(.6,-48,0,18),10,C.Teal,Enum.TextXAlignment.Left)
    shopButtons[item.id] = button(row,"Buy","",UDim2.new(.63,0,0,7),UDim2.new(.35,-8,0,35),item.color,function()
        if item.pass and not player:GetAttribute("NeonOwned") then
            if not passPrice or Config.NeonPassId <= 0 or purchaseBusy then toast("Neon is not on sale yet.");return end
            purchaseBusy = true
            local ok = pcall(function() Marketplace:PromptGamePassPurchase(player,Config.NeonPassId) end)
            if not ok then purchaseBusy = false;toast("Roblox shop unavailable. Try again later.") end
        else send("Equip",item.id) end
    end)
end
local viewButton = button(shop,"Camera","VIEW: ARENA",UDim2.new(.04,0,1,-61),UDim2.new(.44,0,0,32),C.Cream,function()
    overview = not overview
end)
local motionButton = button(shop,"Motion","FX: ON",UDim2.new(.52,0,1,-61),UDim2.new(.44,0,0,32),C.Cream,function()
    reducedMotion = not reducedMotion
    for _,object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Trail") then object.Enabled = not reducedMotion end
    end
end)
text(shop,"SafeShop","No random rewards. No paid advantages.",UDim2.new(.04,0,1,-26),UDim2.new(.92,0,0,18),11,C.Teal)

local result = frame(root,"Result",UDim2.fromScale(.5,.38),UDim2.new(.88,0,0,138))
result.AnchorPoint = Vector2.new(.5,.5);cap(result,540,138);result.Visible = false
local resultTitle = text(result,"Title","HOME SAFE!",UDim2.new(.04,0,0,17),UDim2.new(.92,0,0,44),29,C.Gold)
resultTitle.TextScaled = true
local resultDetail = text(result,"Detail","",UDim2.new(.05,0,0,68),UDim2.new(.9,0,0,50),16)
local toastLabel = text(root,"Toast","",UDim2.new(.5,0,1,-164),UDim2.new(.86,0,0,38),14,C.Cream)
toastLabel.AnchorPoint = Vector2.new(.5,0);toastLabel.BackgroundColor3 = C.Ink;toastLabel.BackgroundTransparency = .1
cap(toastLabel,600,38);round(toastLabel,10);toastLabel.Visible = false

local function inputAction(name,inputState)
    if inputState ~= Enum.UserInputState.Begin or UserInput:GetFocusedTextBox() or not player:GetAttribute("Active") then
        return Enum.ContextActionResult.Pass
    end
    if name == "RumalGrab" then send("Grab") else send("Dash") end
    return Enum.ContextActionResult.Sink
end
ContextAction:BindAction("RumalGrab",inputAction,false,Enum.KeyCode.E,Enum.KeyCode.ButtonX)
ContextAction:BindAction("RumalDash",inputAction,false,Enum.KeyCode.LeftShift,Enum.KeyCode.RightShift,Enum.KeyCode.ButtonB)

local function update()
    local phase = state:GetAttribute("Phase") or "Lobby"
    local active = player:GetAttribute("Active") == true
    local ready = player:GetAttribute("Ready") == true
    local side = player:GetAttribute("Side") or 0
    local seconds = math.max(0,math.ceil((state:GetAttribute("EndsAt") or 0)-workspace:GetServerTimeNow()))
    local coins = player:GetAttribute("Coins") or 0
    local carrier = state:GetAttribute("Carrier") or 0
    if phase ~= lastPhase then
        if phase == "Countdown" then shopOpen = false;helpOpen = false end
        if not reducedMotion and (phase == "Result" or phase == "MatchEnd") then
            result.BackgroundTransparency = .6
            TweenService:Create(result,TweenInfo.new(.25),{BackgroundTransparency=0}):Play()
        end
        lastPhase = phase
    end
    tealScore.Text = "TEAL  "..(state:GetAttribute("TealScore") or 0)
    coralScore.Text = (state:GetAttribute("CoralScore") or 0).."  CORAL"
    clock.Text = (phase == "Live" or phase == "Countdown") and string.format("%02d",seconds) or "RUMAL RUSH"
    matchInfo.Text = string.format("%s  •  ROUND %d  •  FIRST TO %d",state:GetAttribute("Mode") or "Practice",state:GetAttribute("Round") or 0,Config.MatchTarget)
    wallet.Text = string.format("%d COINS",coins)
    if lastCoins and coins > lastCoins then toast("+"..(coins-lastCoins).." coins") end
    lastCoins = coins
    controls.Visible = active and phase == "Live" and not shopOpen and not helpOpen
    exit.Visible = ready and not shopOpen and not helpOpen
    local dashRemaining = math.max(0,(player:GetAttribute("DashReadyAt") or 0)-workspace:GetServerTimeNow())
    dashButton.Text = dashRemaining > 0 and string.format("DASH  %.1fs",dashRemaining) or (UserInput.TouchEnabled and "DASH" or "DASH [SHIFT / B]")
    dashButton.BackgroundColor3 = dashRemaining > 0 and Color3.fromRGB(130,154,156) or C.Teal
    grabButton.Text = carrier == side and carrier > 0 and "RUN HOME!" or (carrier > 0 and "TAG: GET CLOSE" or (UserInput.TouchEnabled and "GRAB" or "GRAB [E / X]"))
    difficulty.Text = "BOT: "..string.upper(player:GetAttribute("Difficulty") or "Easy")
    local isResult = phase == "Result" or phase == "MatchEnd"
    menu.Visible = not ready and not active and not shopOpen and not helpOpen and not (isResult and side > 0)
    shop.Visible = shopOpen;help.Visible = helpOpen
    tools.Visible = not active or phase ~= "Live"
    play.Text = (state:GetAttribute("Match") or 0) > 0 and "PLAY / JOIN NEXT MATCH" or "PLAY A MATCH"
    if active and phase == "Countdown" then
        banner.Text = "YOU ARE "..(side == 1 and "TEAL ←" or "CORAL →").."  •  "..seconds
    elseif active and phase == "Live" then
        if carrier == side then banner.Text = side == 1 and "← RUN TO YOUR TEAL HOME LINE!" or "RUN TO YOUR CORAL HOME LINE! →"
        elseif carrier > 0 then banner.Text = "CHASE THE CARRIER • GET CLOSE TO TAG!"
        else banner.Text = "BAIT YOUR RIVAL • GRAB THE GOLD RUMAL" end
    elseif ready and phase == "Intermission" then
        banner.Text = "MATCH STARTS IN "..seconds.." • FRIENDS CAN JOIN NOW"
    elseif ready and phase ~= "Lobby" and not isResult then
        banner.Text = side == 0 and "QUEUED FOR THE NEXT MATCH" or "WATCH THE DUEL • YOUR TURN IS COMING"
    else banner.Text = "" end
    result.Visible = isResult and ready and not shopOpen and not helpOpen
    if result.Visible then
        resultTitle.Text = state:GetAttribute("Headline") or "ROUND OVER"
        local winner = state:GetAttribute("Winner") or 0
        resultTitle.TextColor3 = winner == 1 and C.Teal or (winner == 2 and C.Coral or C.Gold)
        if phase == "MatchEnd" then
            resultDetail.Text = "Good game! Another match is your choice.\nReturning to the courtyard menu…"
        else
            resultDetail.Text = winner == 0 and "A clean reset. Try a different move next round." or
                ((winner == side and "YOUR TEAM SCORES!" or "THE OTHER TEAM SCORES").."\nNext duel in "..seconds.."s")
        end
    end
    for _,item in ipairs(Cosmetics) do
        local owned = item.pass and player:GetAttribute("NeonOwned") or player:GetAttribute("Own_"..item.id)
        if player:GetAttribute("Equipped") == item.id then shopButtons[item.id].Text = "EQUIPPED"
        elseif owned then shopButtons[item.id].Text = "EQUIP"
        elseif item.pass then shopButtons[item.id].Text = passPrice and (passPrice.." ROBUX") or "NOT ON SALE"
        else shopButtons[item.id].Text = item.cost.." COINS" end
    end
    viewButton.Text = overview and "VIEW: ARENA" or "VIEW: FOLLOW"
    motionButton.Text = reducedMotion and "FX: LOW" or "FX: ON"
    if player:GetAttribute("SaveWarning") then status.Text = "Save delayed — retrying"
    elseif player:GetAttribute("SavingAvailable") == false then status.Text = "Practice session • saving unavailable"
    elseif player:GetAttribute("SavingAvailable") == nil then status.Text = "Loading progress…"
    else status.Text = "Cosmetics only • no paid advantages" end
    status.Visible = not shopOpen and not helpOpen and not menu.Visible
    toastLabel.Visible = os.clock() < notificationUntil;toastLabel.Text = notification
    local view = camera and camera.ViewportSize or Vector2.new(1280,720)
    local available = math.max(240,view.Y-110)
    for _,panel in ipairs({menu,help,shop}) do
        local scale = panel:FindFirstChildOfClass("UIScale")
        if not scale then scale = Instance.new("UIScale");scale.Parent = panel end
        scale.Scale = math.min(1,available/panel.Size.Y.Offset)
    end
end

notice.OnClientEvent:Connect(function(value) if type(value) == "string" then toast(value) end end)
Marketplace.PromptGamePassPurchaseFinished:Connect(function(buyer,id)
    if buyer == player and id == Config.NeonPassId then purchaseBusy = false end
end)
workspace.DescendantAdded:Connect(function(object)
    if reducedMotion and object:IsA("Trail") then object.Enabled = false end
end)
if Config.NeonPassId > 0 then
    task.spawn(function()
        local ok,info = pcall(function() return Marketplace:GetProductInfo(Config.NeonPassId,Enum.InfoType.GamePass) end)
        if ok and info.IsForSale and info.PriceInRobux then passPrice = info.PriceInRobux end
    end)
end
RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    if camera then
        if overview then
            camera.CameraType = Enum.CameraType.Scriptable;camera.FieldOfView = 55
            local view = camera.ViewportSize
            local aspect = math.max(.45,view.X/math.max(1,view.Y))
            local distance = math.max(102,54/(math.tan(math.rad(27.5))*aspect))
            camera.CFrame = CFrame.lookAt(Vector3.new(0,distance*.69,distance*.73),Vector3.zero)
        else
            camera.CameraType = Enum.CameraType.Custom
            local character = player.Character
            local human = character and character:FindFirstChildOfClass("Humanoid")
            if human then camera.CameraSubject = human end
        end
    end
    renderClock += dt
    if renderClock >= .1 then renderClock = 0;update() end
end)
update()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>