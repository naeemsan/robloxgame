local Rules=require("../src/ReplicatedStorage/EmberShared/Rules")
local total=0
local function test(name,fn)
    local ok,err=pcall(fn)
    if not ok then error("FAIL "..name..": "..tostring(err)) end
    total+=1;print("PASS",name)
end
local function eq(a,b) assert(a==b,"expected "..tostring(b)..", got "..tostring(a)) end
local function mission() return {fuses=0,burned=0,fusesNeeded=2,sealsNeeded=6} end
test("reject nonfinite input",function() eq(Rules.finite(0/0),false);eq(Rules.finite(math.huge),false);eq(Rules.finite("3"),false) end)
test("house bounds include furnace",function() eq(Rules.inHouse({x=0,y=4,z=-62}),true) end)
test("garden outside mission bounds",function() eq(Rules.inHouse({x=0,y=4,z=76}),false) end)
test("outside walls invalid",function() eq(Rules.inHouse({x=66,y=4,z=0}),false) end)
test("underfloor invalid",function() eq(Rules.inHouse({x=0,y=-5,z=0}),false) end)
test("NaN position invalid",function() eq(Rules.inHouse({x=0/0,y=4,z=0}),false) end)
test("valid held interaction",function() eq(Rules.canInteract("Playing","Alive",8,3,3),true) end)
test("short hold rejected",function() eq(Rules.canInteract("Playing","Alive",8,.5,3),false) end)
test("engine hold tolerance bounded",function() eq(Rules.canInteract("Playing","Alive",8,2.9,3),true);eq(Rules.canInteract("Playing","Alive",8,2.8,3),false) end)
test("distant interaction rejected",function() eq(Rules.canInteract("Playing","Alive",11,3,3),false) end)
test("lobby interaction rejected",function() eq(Rules.canInteract("Lobby","Alive",1,3,3),false) end)
test("result interaction rejected",function() eq(Rules.canInteract("Result","Alive",1,3,3),false) end)
test("dead and downed cannot interact",function()
    eq(Rules.canInteract("Playing","Downed",1,3,3),false)
    eq(Rules.canInteract("Playing","Dead",1,3,3),false)
end)
test("empty hands can pick up known items",function() eq(Rules.canPickup("Alive","","Fuse"),true);eq(Rules.canPickup("Alive","","Seal"),true) end)
test("full hands cannot duplicate pickup",function() eq(Rules.canPickup("Alive","Fuse","Seal"),false) end)
test("unknown item rejected",function() eq(Rules.canPickup("Alive","","Fake"),false) end)
test("downed pickup rejected",function() eq(Rules.canPickup("Downed","","Fuse"),false) end)
test("burning requires power",function() local m=mission();eq(Rules.deposit(m,"Seal"),false);eq(m.burned,0) end)
test("fuse progression and maximum",function()
    local m=mission();eq(Rules.deposit(m,"Fuse"),true);eq(m.fuses,1)
    eq(Rules.deposit(m,"Fuse"),true);eq(m.fuses,2)
    eq(Rules.deposit(m,"Fuse"),false);eq(m.fuses,2)
end)
test("empty deposit makes no progress",function() local m=mission();eq(Rules.deposit(m,""),false);eq(m.fuses,0);eq(m.burned,0) end)
test("all seals burned once",function()
    local m=mission();m.fuses=2
    for i=1,6 do eq(Rules.deposit(m,"Seal"),true);eq(m.burned,i) end
    eq(Rules.deposit(m,"Seal"),false);eq(m.burned,6)
end)
test("escape gated by six seals",function() local m=mission();eq(Rules.canEscape(m,"Alive"),false);m.burned=6;eq(Rules.canEscape(m,"Alive"),true) end)
test("downed cannot escape",function() local m=mission();m.burned=6;eq(Rules.canEscape(m,"Downed"),false) end)
test("sprinting drains stamina",function() eq(Rules.stamina(100,true,.25),94.5) end)
test("rest restores stamina within cap",function() eq(Rules.stamina(99,false,.25),100) end)
test("stamina never below zero",function() eq(Rules.stamina(1,true,.25),0) end)
test("dt spikes capped",function() eq(Rules.stamina(100,true,10),94.5) end)
test("hidden alive allowed only when unseen",function() eq(Rules.canHide("Alive",false,"Seal"),true);eq(Rules.canHide("Alive",true,""),false) end)
test("downed cannot hide",function() eq(Rules.canHide("Downed",false,""),false) end)
test("living teammate keeps rescue possible",function() eq(Rules.outcome({"Alive","Downed"},100),nil) end)
test("all downed lose unless solo server rescues",function() eq(Rules.outcome({"Downed","Downed"},100),"Lost") end)
test("one escape survives loss of remaining team",function() eq(Rules.outcome({"Escaped","Dead"},100),"Escaped") end)
test("escaped player waits while teammate alive",function() eq(Rules.outcome({"Escaped","Alive"},100),nil) end)
test("timeout with no escape loses",function() eq(Rules.outcome({"Alive"},0),"Lost") end)
test("timeout with escape is partial success",function() eq(Rules.outcome({"Escaped","Alive"},0),"Escaped") end)
test("empty party abandons",function() eq(Rules.outcome({},100),"Abandoned") end)
test("threat increases and caps",function()
    eq(Rules.threat(0,0),0);assert(Rules.threat(2,4)>Rules.threat(2,1));eq(Rules.threat(2,99),1)
end)
test("hidden candidates excluded from monster targeting",function()
    eq(Rules.chooseTarget({{id=1,alive=true,hidden=true,visible=true,distance=1}}),nil)
end)
test("unseen quiet candidate excluded",function()
    eq(Rules.chooseTarget({{id=1,alive=true,hidden=false,visible=false,noisy=false,distance=4}}),nil)
end)
test("running can be heard without line of sight",function()
    eq(Rules.chooseTarget({{id=1,alive=true,hidden=false,visible=false,noisy=true,distance=12}}),1)
end)
test("seal carrier is prioritized at similar range",function()
    eq(Rules.chooseTarget({{id=1,alive=true,visible=true,distance=10},{id=2,alive=true,visible=true,distance=13,carrying=true}}),2)
end)
test("dead target excluded",function() eq(Rules.chooseTarget({{id=1,alive=false,visible=true,distance=1}}),nil) end)
test("movement budget allows walking",function()
    local b=10;for _=1,100 do local ok;ok,b=Rules.movement(b,1.2,.1,25);eq(ok,true) end
end)
test("teleport rejected",function() eq(Rules.movement(10,40,.1,25),false) end)
test("complete mission simulation",function()
    local m=mission();local inventory=""
    for _=1,2 do assert(Rules.canPickup("Alive",inventory,"Fuse"));inventory="Fuse";assert(Rules.deposit(m,inventory));inventory="" end
    for _=1,6 do assert(Rules.canPickup("Alive",inventory,"Seal"));inventory="Seal";assert(Rules.deposit(m,inventory));inventory="" end
    eq(Rules.canEscape(m,"Alive"),true);eq(Rules.outcome({"Escaped","Escaped"},100),"Escaped")
end)
print(string.format("RESULT: %d horror rule tests passed",total))
