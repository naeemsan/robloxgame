local count = 0
local function test(name,fn)
    local ok,err=pcall(fn)
    if not ok then error("FAIL: "..name.."\n"..tostring(err)) end
    count+=1;print("PASS",name)
end
local function eq(a,b) assert(a==b,"expected "..tostring(b)..", got "..tostring(a)) end
test("new profile loads and takes session lease",function()
    local p=player(1);Profiles.load(p)
    eq(p:GetAttribute("SavingAvailable"),true);eq(p:GetAttribute("Coins"),0)
    assert(database.player_1.lock.token);eq(database.player_1.owned.Classic,true)
end)
test("rewards, cosmetic purchase and save survive reload",function()
    local p=player(2);Profiles.load(p);Profiles.reward(p,100,true)
    eq(Profiles.buy(p,"Mint"),true);eq(p:GetAttribute("Coins"),20)
    Profiles.remove(p)
    eq(database.player_2.lock,nil)
    local joined=player(2);Profiles.load(joined)
    eq(joined:GetAttribute("SavingAvailable"),true)
    eq(joined:GetAttribute("Coins"),20);eq(joined:GetAttribute("Wins"),1)
    eq(joined:GetAttribute("Own_Mint"),true);eq(joined:GetAttribute("Equipped"),"Mint")
end)
test("existing live lease cannot be overwritten",function()
    local first=player(3);Profiles.load(first)
    local token=database.player_3.lock.token
    local other=player(3);Profiles.load(other)
    eq(other:GetAttribute("SavingAvailable"),false)
    Profiles.reward(other,9999,false);Profiles.save(other,false)
    eq(database.player_3.coins,0);eq(database.player_3.lock.token,token)
end)
test("expired lease can be recovered",function()
    database.player_4={coins=55,owned={},lock={token="expired",expires=0}}
    local p=player(4);Profiles.load(p)
    eq(p:GetAttribute("Coins"),55);eq(p:GetAttribute("SavingAvailable"),true)
    assert(database.player_4.lock.token~="expired")
end)
test("lost lease disables subsequent saves",function()
    local p=player(5);Profiles.load(p)
    database.player_5.lock.token="new-server"
    Profiles.reward(p,100,false);Profiles.save(p,false)
    eq(p:GetAttribute("SavingAvailable"),false);eq(database.player_5.coins,0)
end)
test("failed initial load enters practice without writing defaults",function()
    database.player_6={coins=700}
    failRequests=true
    local p=player(6);Profiles.load(p)
    eq(p:GetAttribute("SavingAvailable"),false)
    failRequests=false
    Profiles.reward(p,50,false);Profiles.save(p,true)
    eq(database.player_6.coins,700)
end)
test("save failure retains session for a later retry",function()
    local p=player(7);Profiles.load(p);Profiles.reward(p,44,false)
    failRequests=true;Profiles.save(p,false)
    eq(p:GetAttribute("SaveWarning"),true)
    failRequests=false;Profiles.save(p,false)
    eq(database.player_7.coins,44);eq(p:GetAttribute("SaveWarning"),false)
end)
test("unknown cosmetic and fake pass ownership rejected",function()
    local p=player(8);Profiles.load(p)
    eq(Profiles.buy(p,"Unknown"),false);eq(Profiles.buy(p,"Neon"),false)
    p:SetAttribute("NeonOwned",true)
    eq(Profiles.buy(p,"Neon"),true);eq(p:GetAttribute("Equipped"),"Neon")
end)
test("malformed stored values sanitized",function()
    database.player_9={coins=0/0,wins=-5,owned={Mint=true,Hack=true},equipped="Hack"}
    local p=player(9);Profiles.load(p)
    eq(p:GetAttribute("Coins"),0);eq(p:GetAttribute("Wins"),0)
    eq(p:GetAttribute("Own_Mint"),true);eq(p:GetAttribute("Equipped"),"Classic")
end)
test("departure during load releases acquired lease",function()
    local p=player(10);p.Parent=nil
    Profiles.load(p)
    eq(database.player_10.lock,nil);eq(Profiles.get(p),nil)
end)
test("autosave renews lease and exit clears it",function()
    local p=player(11);Profiles.load(p)
    database.player_11.lock.expires=1
    Profiles.save(p,false)
    assert(database.player_11.lock.expires>os.time())
    Profiles.remove(p);eq(database.player_11.lock,nil)
end)
print(string.format("RESULT: %d persistence tests passed (mock service)",count))
